<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= coupon.title %> - Kupota</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-brand {
            font-weight: 700;
            color: #6a1b9a !important;
        }

        .top-bar {
            background-color: #6a1b9a;
            color: #fff;
            font-size: 0.8rem;
        }

        .top-bar a {
            color: #fff;
            text-decoration: none;
            margin-left: 1rem;
        }

        .detail-card {
            border: none;
            border-radius: 12px;
            background-color: #ffffff;
            overflow: hidden;
        }

        .coupon-detail-img {
            width: 100%;
            max-height: 380px;
            object-fit: cover;
            border-radius: 8px;
        }

        .btn-purple {
            background-color: #6a1b9a;
            color: #ffffff;
            font-weight: 600;
            border: none;
            transition: background-color 0.2s ease;
        }

        .btn-purple:hover {
            background-color: #53147d;
            color: #ffffff;
        }

        .qr-card {
            background-color: #f8f9fa;
            border: 1px dashed #6a1b9a;
            border-radius: 10px;
        }

        footer {
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            margin-top: auto;
        }
    </style>
</head>

<body>

    <!-- Top utility bar -->
    <div class="top-bar py-1 px-3 text-end">
        <a href="/profile">Profile</a>
        <a href="/logout">Logout</a>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand me-4" href="/">Kupota</a>
            <div class="d-flex align-items-center ms-auto">
                <a href="/" class="btn btn-outline-dark btn-sm px-3 me-2">&larr; Back to Deals</a>
                <a href="/profile" class="btn btn-outline-purple btn-sm px-3" style="color: #6a1b9a; border-color: #6a1b9a;">Profile</a>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container py-5 flex-grow-1">
        <div class="card detail-card shadow-sm p-3 p-md-4">
            <div class="row g-4">
                
                <!-- Left Column: Gambar & QR Code Share -->
                <div class="col-lg-6">
                    <img src="<%= coupon.image %>" alt="<%= coupon.title %>" class="coupon-detail-img shadow-sm mb-4">
                    
                    <!-- QR Code Box (Fitur Quick Share / Scan) -->
                    <div class="qr-card p-3 text-center">
                        <div class="d-flex align-items-center justify-content-center gap-3">
                            <img src="<%= qrCodeUrl %>" alt="QR Link Kupon" width="100" height="100" class="bg-white p-1 border rounded shadow-sm">
                            <div class="text-start">
                                <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.9rem;">Scan via HP</h6>
                                <p class="text-muted small mb-0" style="font-size: 0.78rem;">
                                    Pindai QR code ini untuk membuka halaman promo ini secara langsung di ponsel kamu.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Informasi Detail Kupon -->
                <div class="col-lg-6 d-flex flex-column justify-content-between">
                    <div>
                        <!-- Category Badge -->
                        <span class="badge bg-purple-subtle text-purple mb-2 px-3 py-2" style="color: #6a1b9a; background-color: #f3e5f5; font-size: 0.8rem;">
                            <%= coupon.Category ? coupon.Category.name : 'Uncategorized' %>
                        </span>

                        <h2 class="fw-bold text-dark mb-3"><%= coupon.title %></h2>

                        <!-- Price Section -->
                        <div class="mb-4">
                            <span class="text-muted small d-block">Harga Promo:</span>
                            <h3 class="fw-bold text-dark mb-0">
                                <%= formatPrice(coupon.price) %>
                            </h3>
                        </div>

                        <hr class="text-muted">

                        <!-- Description -->
                        <div class="mb-4">
                            <h6 class="fw-bold text-secondary small text-uppercase mb-2">Deskripsi Promo</h6>
                            <p class="text-dark lh-base"><%= coupon.description %></p>
                        </div>

                        <!-- Meta Info (Stock & Expired) -->
                        <div class="row g-2 mb-4">
                            <div class="col-6">
                                <div class="p-2 border rounded bg-light text-center">
                                    <span class="text-muted small d-block" style="font-size: 0.75rem;">Sisa Stok</span>
                                    <span class="fw-bold <%= coupon.stock > 0 ? 'text-success' : 'text-danger' %>">
                                        <%= coupon.stock %> Tiket
                                    </span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 border rounded bg-light text-center">
                                    <span class="text-muted small d-block" style="font-size: 0.75rem;">Berlaku Hingga</span>
                                    <span class="fw-bold text-dark small">
                                        <%= formatDate(coupon.expired_date) %>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Action Button -->
                    <div>
                        <% if (coupon.stock > 0) { %>
                            <button type="button" class="btn btn-purple w-100 py-3 shadow-sm fs-6" onclick="alert('Terima kasih! Fitur klaim/pemesanan sedang disiapkan.')">
                                Claim / Buy Deal Now
                            </button>
                        <% } else { %>
                            <button class="btn btn-secondary w-100 py-3 fs-6" disabled>
                                Kupon Sudah Habis
                            </button>
                        <% } %>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="py-4 px-4">
        <div class="container-fluid text-center">
            <p class="text-muted small mb-0">&copy; 2026 Kupotan. All rights reserved. | Terms of Use | Privacy Policy</p>
        </div>
    </footer>

</body>

</html>