<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - Kupota</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-brand {
            font-weight: 700;
            color: #6a1b9a !important;
        }

        .top-bar {
            background-color: #6a1b9a;
            color: #fff;
            font-size: 0.8rem;
        }

        .top-bar a {
            color: #fff;
            text-decoration: none;
            margin-left: 1rem;
        }

        .profile-card {
            border: none;
            border-radius: 12px;
            background-color: #ffffff;
            max-width: 600px;
            width: 100%;
        }

        .avatar-circle {
            width: 80px;
            height: 80px;
            background-color: #6a1b9a;
            color: #ffffff;
            font-size: 2rem;
            font-weight: 700;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-purple {
            background-color: #6a1b9a;
            color: #ffffff;
            font-weight: 600;
            border: none;
            transition: background-color 0.2s ease;
        }

        .btn-purple:hover {
            background-color: #53147d;
            color: #ffffff;
        }

        .form-control:focus {
            border-color: #6a1b9a;
            box-shadow: 0 0 0 0.25rem rgba(106, 27, 154, 0.15);
        }

        footer {
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            margin-top: auto;
        }
    </style>
</head>

<body>

    <!-- Top utility bar -->
    <div class="top-bar py-1 px-3 text-end">
        <a href="/logout">Logout</a>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="/">Kupota</a>
            <div class="d-flex align-items-center ms-auto">
                <a href="/" class="btn btn-outline-dark btn-sm px-3 me-2">&larr; Back to Home</a>
                <a href="/logout" class="btn btn-outline-danger btn-sm px-3">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container d-flex justify-content-center align-items-center flex-grow-1 py-5">
        <div class="card profile-card shadow-sm p-3 p-md-4">
            <div class="card-body">

                <!-- Header Profile (Avatar & Nama) -->
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                    <div class="avatar-circle me-3">
                        <%= profile && profile.first_name ? profile.first_name.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0">
                            <%= profile && profile.first_name ? profile.fullName : 'User Profile' %>
                        </h4>
                        <p class="text-muted small mb-0"><%= user ? user.email : '' %></p>
                        <span class="badge bg-purple-subtle text-purple border mt-1" style="color: #6a1b9a; background-color: #f3e5f5;">
                            Role: <%= user ? user.role : 'user' %>
                        </span>
                    </div>
                </div>

                <!-- Tampilan Detail Data Profile -->
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label class="small text-muted fw-semibold">First Name</label>
                        <p class="fw-medium text-dark mb-0"><%= profile && profile.first_name ? profile.first_name : '-' %></p>
                    </div>
                    <div class="col-6">
                        <label class="small text-muted fw-semibold">Last Name</label>
                        <p class="fw-medium text-dark mb-0"><%= profile && profile.last_name ? profile.last_name : '-' %></p>
                    </div>
                    <div class="col-12">
                        <label class="small text-muted fw-semibold">Phone Number</label>
                        <p class="fw-medium text-dark mb-0"><%= profile && profile.phone ? profile.phone : '-' %></p>
                    </div>
                    <div class="col-12">
                        <label class="small text-muted fw-semibold">Address</label>
                        <p class="fw-medium text-dark mb-0"><%= profile && profile.address ? profile.address : '-' %></p>
                    </div>
                </div>

                <!-- Action Buttons (Edit & Delete) -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <!-- Tombol Hapus Akun -->
                    <form action="/profile/delete" method="POST" onsubmit="return confirm('Apakah Anda yakin ingin menghapus profil/akun ini secara permanen?')">
                        <button type="submit" class="btn btn-outline-danger btn-sm px-3">Delete Profile</button>
                    </form>

                    <!-- Tombol Pemicu Modal Edit -->
                    <button type="button" class="btn btn-purple btn-sm px-4" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                        Edit Profile
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- Modal Form Edit Profile -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" aria-labelledby="editProfileModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editProfileModalLabel">Edit Profile</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form action="/profile/edit" method="POST">
                    <div class="modal-body py-3">
                        <div class="row g-3 mb-3">
                            <div class="col-6">
                                <label for="first_name" class="form-label small fw-semibold text-secondary">First Name</label>
                                <input type="text" class="form-control" id="first_name" name="first_name" value="<%= profile ? profile.first_name : '' %>" required>
                            </div>
                            <div class="col-6">
                                <label for="last_name" class="form-label small fw-semibold text-secondary">Last Name</label>
                                <input type="text" class="form-control" id="last_name" name="last_name" value="<%= profile ? profile.last_name : '' %>">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="phone" class="form-label small fw-semibold text-secondary">Phone Number</label>
                            <input type="text" class="form-control" id="phone" name="phone" value="<%= profile ? profile.phone : '' %>" placeholder="08123456789">
                        </div>
                        <div class="mb-3">
                            <label for="address" class="form-label small fw-semibold text-secondary">Address</label>
                            <textarea class="form-control" id="address" name="address" rows="3" placeholder="Alamat lengkap..."><%= profile ? profile.address : '' %></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top-0 pt-0">
                        <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-purple px-4">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="py-4 px-4">
        <div class="container-fluid text-center">
            <p class="text-muted small mb-0">&copy; 2026 Kupotan. All rights reserved. | Terms of Use | Privacy Policy</p>
        </div>
    </footer>

    <!-- Bootstrap 5 JS CDN (Diperlukan agar Modal Edit dapat terbuka) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>