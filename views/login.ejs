<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Kupota</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-brand {
            font-weight: 700;
            color: #6a1b9a !important;
        }

        .top-bar {
            background-color: #6a1b9a;
            color: #fff;
            font-size: 0.8rem;
        }

        .top-bar a {
            color: #fff;
            text-decoration: none;
            margin-left: 1rem;
        }

        /* Auth Card Styling */
        .auth-container {
            max-width: 420px;
            width: 100%;
        }

        .auth-card {
            border: none;
            border-radius: 12px;
            background-color: #ffffff;
        }

        .btn-purple {
            background-color: #6a1b9a;
            color: #ffffff;
            font-weight: 600;
            border: none;
            transition: background-color 0.2s ease;
        }

        .btn-purple:hover {
            background-color: #53147d;
            color: #ffffff;
        }

        .form-control:focus {
            border-color: #6a1b9a;
            box-shadow: 0 0 0 0.25rem rgba(106, 27, 154, 0.15);
        }

        footer {
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            margin-top: auto;
        }
    </style>
</head>

<body>

    <!-- Top utility bar -->
    <div class="top-bar py-1 px-3 text-end">
        <a href="/profile">Profile</a>
        <a href="/register">Sign Up</a>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand" href="/">Kupota</a>
            <div class="d-flex align-items-center">
                <span class="text-muted small me-2">Belum punya akun?</span>
                <a href="/register" class="btn btn-outline-dark btn-sm px-3">Register</a>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <div class="container d-flex align-items-center justify-content-center flex-grow-1 py-5">
        <div class="auth-container">
            <div class="card auth-card shadow-sm p-4">
                <div class="card-body">
                    <h4 class="fw-bold mb-1">Masuk ke Kupota</h4>
                    <p class="text-muted small mb-4">Silakan masukkan email dan password akun Anda.</p>

                    <form action="/login" method="POST">
                        <!-- Input Email -->
                        <div class="mb-3">
                            <label for="email" class="form-label small fw-semibold text-secondary">Email</label>
                            <input type="email" class="form-control" id="email" name="email"
                                placeholder="nama@email.com">
                        </div>

                        <!-- Input Password -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label for="password"
                                    class="form-label small fw-semibold text-secondary mb-0">Password</label>
                                <a href="#" class="small text-decoration-none" style="color: #6a1b9a;">Lupa
                                    Password?</a>
                            </div>
                            <input type="password" class="form-control" id="password" name="password"
                                placeholder="Masukkan password Anda">
                        </div>

                        <!-- Container Pesan Error / Penjaga Jarak Utuh -->
                        <div class="error-container mb-3" style="min-height: 44px;">
                            <% if (typeof error !=='undefined' && error) { %>
                                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center mb-0 border-0 shadow-sm"
                                    role="alert">
                                    <svg class="bi flex-shrink-0 me-2" width="16" height="16" fill="currentColor"
                                        viewBox="0 0 16 16">
                                        <path
                                            d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                                        <path
                                            d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z" />
                                    </svg>
                                    <div>
                                        <%= error %>
                                    </div>
                                </div>
                                <% } %>
                        </div>

                        <!-- Tombol Submit -->
                        <button type="submit" class="btn btn-purple w-100 py-2 mb-3">Login</button>
                    </form>

                    <div class="text-center mt-3">
                        <p class="small text-muted mb-0">
                            Belum memiliki akun? <a href="/register" class="fw-semibold text-decoration-none"
                                style="color: #6a1b9a;">Daftar Sekarang</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="py-4 px-4">
        <div class="container-fluid text-center">
            <p class="text-muted small mb-0">&copy; 2026 Kupotan. All rights reserved. | Terms of Use | Privacy Policy
            </p>
        </div>
    </footer>

</body>

</html>