<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kupota CMS - Admin Dashboard</title>
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: 700;
            color: #6a1b9a !important;
        }

        .top-bar {
            background-color: #6a1b9a;
            color: #fff;
            height: 28px;
        }

        /* Container Filter Kategori */
        .category-bar-wrapper {
            background-color: #ffffff;
            border-bottom: 1px solid #e9ecef;
            padding: 8px 0;
        }

        /* Scroll Horizontal Kategori */
        .category-scroll {
            display: flex;
            align-items: center;
            gap: 6px;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: none;
        }

        .category-scroll::-webkit-scrollbar {
            display: none;
        }

        /* Button Kategori Mini & Modern */
        .btn-cat-chip {
            background-color: #f1f3f5;
            color: #495057;
            border: 1px solid #e9ecef;
            border-radius: 16px;
            font-size: 0.78rem;
            font-weight: 500;
            padding: 3px 12px;
            transition: all 0.2s ease;
            cursor: pointer;
            line-height: 1.4;
            flex-shrink: 0;
        }

        .btn-cat-chip:hover {
            background-color: #6a1b9a;
            color: #ffffff;
            border-color: #6a1b9a;
        }

        .btn-purple {
            background-color: #6a1b9a;
            color: #ffffff;
            font-weight: 500;
        }

        .btn-purple:hover {
            background-color: #53147d;
            color: #ffffff;
        }

        .table-card {
            border: none;
            border-radius: 8px;
            background-color: #ffffff;
            overflow: hidden;
        }

        .coupon-img-thumb {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 6px;
        }

        footer {
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            margin-top: 3rem;
        }
    </style>
</head>

<body>

    <!-- Top utility bar (Polos tanpa teks link) -->
    <div class="top-bar py-1 px-3"></div>

    <!-- Main Navbar (Search Form & Logout Button) -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2">
        <div class="container-fluid px-4">
            <a class="navbar-brand me-4" href="/cms">Kupota <span class="badge bg-secondary fs-6 align-middle ms-1">CMS</span></a>

            <!-- Search Form -->
            <form action="/cms" method="GET" class="flex-grow-1 me-4">
                <input class="form-control form-control-sm" type="search" name="search" placeholder="Search deals in CMS...">
            </form>

            <div class="d-flex align-items-center flex-shrink-0">
                <a href="/logout" class="btn btn-outline-danger btn-sm px-3 fw-semibold">Logout</a>
            </div>
        </div>
    </nav>

    <!-- Sub-Bar Kategori Filter -->
    <div class="category-bar-wrapper shadow-sm">
        <div class="container-fluid px-4">
            <form action="/cms" method="GET">
                <div class="category-scroll">
                    <button type="submit" name="category" value="" class="btn-cat-chip">Semua</button>
                    <% cat.forEach(el => { %>
                        <button type="submit" name="category" value="<%= el.id %>" class="btn-cat-chip">
                            <%= el.name %>
                        </button>
                    <% }) %>
                </div>
            </form>
        </div>
    </div>

    <!-- Main Content Table Container -->
    <div class="container-fluid px-4 py-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h4 class="fw-bold mb-0">Coupon Management</h4>
            <a href="/coupons/add" class="btn btn-purple btn-sm px-3 shadow-sm">+ Add New Coupon</a>
        </div>

        <div class="card table-card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="ps-3">Image</th>
                            <th scope="col">Title</th>
                            <th scope="col">Description</th>
                            <th scope="col">Category</th>
                            <th scope="col">Price</th>
                            <th scope="col">Stock</th>
                            <th scope="col">Expired Date</th>
                            <th scope="col" class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (coupons && coupons.length > 0) { %>
                            <% coupons.forEach(function(coupon) { %>
                                <tr>
                                    <td class="ps-3">
                                        <img src="<%= coupon.image %>" alt="<%= coupon.title %>" class="coupon-img-thumb shadow-sm">
                                    </td>
                                    <td class="fw-semibold text-dark"><%= coupon.title %></td>
                                    <td class="text-muted small" style="max-width: 220px;">
                                        <%= coupon.description %>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <%= coupon.Category ? coupon.Category.name : '-' %>
                                        </span>
                                    </td>
                                    <td class="fw-bold text-dark">
                                        <%= typeof formatPrice === 'function' ? formatPrice(coupon.price) : 'Rp ' + coupon.price.toLocaleString('id-ID') %>
                                    </td>
                                    <td>
                                        <span class="badge <%= coupon.stock > 0 ? 'bg-success-subtle text-success border border-success-subtle' : 'bg-danger-subtle text-danger border border-danger-subtle' %>">
                                            <%= coupon.stock %>
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        <%= new Date(coupon.expired_date).toLocaleDateString('id-ID', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a href="/coupons/<%= coupon.id %>/edit" class="btn btn-sm btn-outline-primary py-1 px-2" style="font-size: 0.75rem;">Edit</a>
                                            <a href="/coupons/<%= coupon.id %>/delete" class="btn btn-sm btn-outline-danger py-1 px-2" style="font-size: 0.75rem;" onclick="return confirm('Apakah Anda yakin ingin menghapus kupon ini?')">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    Tidak ada data kupon yang ditemukan.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

    <!-- Footer -->
    <footer class="py-4 px-4">
        <div class="container-fluid">
            <p class="text-muted small mb-0">&copy; 2026 Kupotan. All rights reserved. | Terms of Use | Privacy Policy</p>
        </div>
    </footer>

</body>

</html>