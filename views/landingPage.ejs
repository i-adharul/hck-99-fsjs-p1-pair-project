<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kupota - Temukan Kupon Wisata Terbaik</title>
    <!-- Bootstrap 5 CSS CDN (JS & Icons dihilangkan) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .navbar-brand {
            font-weight: 700;
            color: #6a1b9a !important;
        }

        /* Container Filter Kategori */
        .category-bar-wrapper {
            background-color: #ffffff;
            border-bottom: 1px solid #e9ecef;
            padding: 8px 0;
        }

        /* Scroll Horizontal Kategori */
        .category-scroll {
            display: flex;
            align-items: center;
            gap: 6px;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: none;
            /* Firefox */
        }

        .category-scroll::-webkit-scrollbar {
            display: none;
            /* Chrome/Safari */
        }

        /* Button Kategori Mini & Modern */
        .btn-cat-chip {
            background-color: #f1f3f5;
            color: #495057;
            border: 1px solid #e9ecef;
            border-radius: 16px;
            font-size: 0.78rem;
            font-weight: 500;
            padding: 3px 12px;
            transition: all 0.2s ease;
            cursor: pointer;
            line-height: 1.4;
            flex-shrink: 0;
            /* Mencegah tombol mengkerut */
        }

        .btn-cat-chip:hover {
            background-color: #6a1b9a;
            color: #ffffff;
            border-color: #6a1b9a;
        }

        /* Card Coupon Styling */
        .coupon-card {
            border: none;
            border-radius: 8px;
            overflow: hidden;
            transition: box-shadow 0.2s ease;
            height: 100%;
        }

        .coupon-card:hover {
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
        }

        .coupon-card img {
            height: 200px;
            object-fit: cover;
            width: 100%;
        }

        .coupon-price {
            font-weight: 700;
            font-size: 1.1rem;
            color: #212529;
        }

        .coupon-category {
            font-size: 0.8rem;
            color: #6c757d;
        }

        .section-title {
            font-weight: 700;
            margin-bottom: 1.25rem;
        }

        .top-bar {
            background-color: #6a1b9a;
            color: #fff;
            font-size: 0.8rem;
        }

        .top-bar a {
            color: #fff;
            text-decoration: none;
            margin-left: 1rem;
        }

        footer {
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            margin-top: 3rem;
        }

        footer h6 {
            font-weight: 700;
            font-size: 0.85rem;
        }

        footer a {
            color: #495057;
            text-decoration: none;
            font-size: 0.85rem;
            display: block;
            margin-bottom: 0.4rem;
        }

        footer a:hover {
            color: #6a1b9a;
        }
    </style>
</head>

<body>

    <!-- Top Utility Bar / Header -->
    <div class="top-bar py-1 px-3 text-end">
        <% if (isLoggedIn) { %>
            <!-- Tampilan Jika User Sudah Login -->
            <a href="/profile" class="text-white text-decoration-none small">My Profile</a>
            <% } else { %>
                <!-- Tampilan Jika User Belum Login -->
                <a href="/login" class="text-white text-decoration-none small me-2">Login</a>
                <a href="/register" class="text-white text-decoration-none small">Register</a>
                <% } %>
    </div>

    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-2">
        <div class="container-fluid px-4 d-flex align-items-center justify-content-between">

            <!-- Logo -->
            <a class="navbar-brand me-4 fw-bold flex-shrink-0" href="/" style="color: #6a1b9a;">Kupota</a>

            <!-- Form Search -->
            <form action="/" method="GET" class="flex-grow-1 mx-3">
                <input class="form-control form-control-sm w-100" type="search" name="search"
                    placeholder="Cari promo, diskon, atau tempat wisata..."
                    value="<%= typeof search !== 'undefined' ? search : '' %>">
            </form>

            <!-- Tombol Aksi Navigasi -->
            <div class="d-flex align-items-center flex-shrink-0">
                <% if (isLoggedIn) { %>
                    <!-- Jika Sudah Login: Hanya Tampilkan Tombol Profile -->
                    <a href="/profile" class="btn btn-purple btn-sm px-3"
                        style="background-color: #6a1b9a; color: #fff;">My Profile</a>
                    <% } else { %>
                        <!-- Jika Belum Login: Tampilkan Login & Register -->
                        <a href="/login" class="btn btn-outline-dark btn-sm px-3 me-2">Login</a>
                        <a href="/register" class="btn btn-purple btn-sm px-3"
                            style="background-color: #6a1b9a; color: #fff;">Register</a>
                        <% } %>
            </div>

        </div>
    </nav>

    <!-- Sub-Bar Kategori (Tepat di bawah Search Bar) -->
    <div class="category-bar-wrapper shadow-sm">
        <div class="container-fluid px-4">
            <form action="/" method="GET">
                <div class="category-scroll">
                    <button type="submit" name="category" value="" class="btn-cat-chip">Semua</button>
                    <% cat.forEach(el=> { %>
                        <button type="submit" name="category" value="<%= el.id %>" class="btn-cat-chip">
                            <%= el.name %>
                        </button>
                        <% }) %>
                </div>
            </form>
        </div>
    </div>

    <div class="container-fluid px-4 py-4">

        <h4 class="section-title">Popular on Kupota</h4>

        <div class="row g-4">
            <% coupons.forEach(function(coupon) { %>
                <div class="col-6 col-md-4 col-lg-3">
                    <div class="card coupon-card shadow-sm">
                        <a href="/coupons/<%= coupon.id %>">
                            <img src="<%= coupon.image %>" alt="<%= coupon.title %>">
                        </a>
                        <div class="card-body">
                            <p class="coupon-category mb-1">
                                <%= coupon.Category.name %>
                            </p>
                            <h6 class="card-title mb-2">
                                <a href="/coupons/<%= coupon.id %>" class="text-decoration-none text-dark">
                                    <%= coupon.title %>
                                </a>
                            </h6>
                            <p class="coupon-price mb-0">
                                <%= formatPrice(coupon.price) %>
                            </p>
                            <p class="text-muted small mb-0">Stock: <%= coupon.stock %>
                            </p>
                        </div>
                    </div>
                </div>
                <% }); %>
        </div>

    </div>

    <!-- Footer -->
    <footer class="py-5 px-4">
        <div class="container-fluid">

            <p class="text-muted small mb-0">&copy; 2026 Kupotan. All rights reserved. | Terms of Use | Privacy Policy |
                Do Not Sell or Share Kupotan Information</p>
        </div>
    </footer>

</body>

</html>